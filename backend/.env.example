# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — Supabase dashboard > Project Settings > API
SUPABASE_URL=

# Anon (public) key — used for general DB queries from the backend
SUPABASE_KEY=

# Service role key — NEVER expose client-side; used only in this backend
# Supabase dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# ── URLs ──────────────────────────────────────────────────────────────────────
# Deployed frontend URL — used in invite/reset email links and CORS
# e.g. https://lab-manager.vercel.app
FRONTEND_URL=

# Deployed backend URL — used in meeting confirmation email links
# e.g. https://your-backend.vercel.app
BACKEND_URL=

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# Gmail account used to send notifications
GMAIL_USER=

# Gmail App Password (not your account password)
# Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=

# ── Google Drive backup ───────────────────────────────────────────────────────
# Folder ID from the Drive URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# OAuth2 credentials JSON — from Google Cloud Console > APIs & Services > Credentials
OAUTH_CREDENTIALS=

# Drive OAuth token JSON — generated by running: node get-drive-token.js
DRIVE_TOKEN=

# ── Webhook ───────────────────────────────────────────────────────────────────
# Shared secret for the auth.audit_log_entries PostgreSQL trigger → /api/auth/ingest-auth-event
# Generate with: openssl rand -hex 32
# Also set this in the Supabase SQL Editor:
#   ALTER DATABASE postgres SET "app.webhook_secret" TO '<same value>';
WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
