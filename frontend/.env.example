# Supabase project URL — found in Supabase dashboard > Project Settings > API
REACT_APP_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in the browser; RLS is the defense layer
REACT_APP_SUPABASE_ANON_KEY=

# Deployed backend URL (e.g. https://your-backend.vercel.app)
# Use http://localhost:3001 for local development
REACT_APP_BACKEND_URL=
